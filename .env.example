# Copy to `.env` and adjust. Every VITE_* value is PUBLIC — it ships to the browser.
# There is no API key in this app: a person signs in against the auth instance and the
# identity token they get back is the only credential the page holds.

# The altengine API origin. The local emulator (`altengine dev`) listens here:
VITE_ALTENGINE_URL=http://127.0.0.1:9191
# Hosted would be:
# VITE_ALTENGINE_URL=https://api.altengine.net

# The instances DutyBoard uses. See the README for what each one is for.
VITE_AUTH_INSTANCE=dutyboard-auth
VITE_DATASTORE_INSTANCE=dutyboard
VITE_CHANNEL_INSTANCE=dutyboard-live
VITE_FUNCTIONS_INSTANCE=dutyboard

# The deployed function's name — the first path segment under its host. `api` is reserved
# by the platform on a function host, which is why this is not that.
VITE_FUNCTION_NAME=board

# Where the function is reachable. Left blank it is derived from the values above —
# `https://<functions instance>-fn.altengine.app/board` hosted, `<url>/fn/<instance>/board`
# against a local emulator. Set it only when neither is right (a tunnel, a custom domain).
# VITE_API_URL=

# --- deploy-time only (not shipped to the browser) -------------------------------------
# ALTENGINE_KEY=ak_...          # needs 'full' on the functions instance
# ALTENGINE_URL=https://api.altengine.net
# DUTYBOARD_FN_INSTANCE=dutyboard
# DUTYBOARD_FN_NAME=board
# DUTYBOARD_DATASTORE=dutyboard
# DUTYBOARD_AUTH=dutyboard-auth
# DUTYBOARD_CHANNEL=dutyboard-live
# DUTYBOARD_ORIGINS=https://board.example.com    # CORS for the console's origin
