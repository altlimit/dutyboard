# Copy to `.env` (or `.env.local`) and adjust. All VITE_* vars are PUBLIC — they ship
# to the browser. Never put an org API key or any secret here; the whole point of
# DutyBoard is that the browser talks to altengine as the end-user, with no backend.

# altengine API origin. Local emulator (`altengine dev`) listens here by default:
VITE_ALTENGINE_URL=http://127.0.0.1:9191
# Production would be:
# VITE_ALTENGINE_URL=https://api.altengine.net

# The three instances a tenant creates for DutyBoard (see README "Backend setup"):
VITE_AUTH_INSTANCE=dutyboard-auth
VITE_DATASTORE_INSTANCE=dutyboard
VITE_CHANNEL_INSTANCE=dutyboard-live
