{
  "name": "dutyboard",
  "version": "2.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "DutyBoard \u2014 a coordination bus, external working memory and human-in-the-loop decision engine for autonomous agents, built on altengine functions + datastore + auth + channel.",
  "scripts": {
    "dev": "vite",
    "dev:site": "sitegen -serve",
    "build": "npm run build:site && npm run build:app && npm run build:bundle",
    "build:site": "sitegen -minify -clean",
    "build:app": "vite build",
    "build:fn": "node functions/build.mjs",
    "provision": "sh scripts/provision.sh",
    "setup": "node scripts/setup.mjs",
    "deploy": "npm run build:fn && node scripts/deploy.mjs",
    "demo": "node scripts/demo.mjs",
    "preview": "node scripts/serve.mjs",
    "smoke": "node scripts/smoke.mjs",
    "build:bundle": "npm run build:fn && node scripts/publish-bundle.mjs"
  },
  "dependencies": {
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "esbuild": "^0.25.0",
    "vite": "^6.0.7"
  }
}
